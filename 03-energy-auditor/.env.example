# Energy Auditor Environment Configuration
# Copy to .env and adjust as needed

# Database
DATABASE_URL=postgresql+asyncpg://energy:energy@localhost:5432/energy_auditor
DATABASE_URL_SYNC=postgresql+psycopg2://energy:energy@localhost:5432/energy_auditor

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Tariff Defaults
PEAK_RATE_KWH=0.18
SHOULDER_RATE_KWH=0.12
OFFPEAK_RATE_KWH=0.07
DEMAND_CHARGE_KVA=15.0
PF_PENALTY_THRESHOLD=0.90

# Anomaly Detection
ZSCORE_THRESHOLD=3.0
ROLLING_WINDOW_HOURS=168

# ISO 50001
BASELINE_YEAR=2024
ENPI_TARGET_REDUCTION_PCT=2.0
