# Process Optimizer Configuration
# Copy this file to .env and fill in values

# --- Application ---
PROC_OPT_APP_NAME=ProcessOptimizer
PROC_OPT_DEBUG=false
PROC_OPT_LOG_LEVEL=INFO

# --- Redis ---
PROC_OPT_REDIS_URL=redis://redis:6379/0
PROC_OPT_REDIS_STATE_TTL_SECONDS=300
PROC_OPT_REDIS_OPTIMIZATION_TTL_SECONDS=60

# --- Kafka ---
PROC_OPT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PROC_OPT_KAFKA_CONSUMER_GROUP=process-optimizer-group
PROC_OPT_KAFKA_SENSOR_TOPIC=sensor-readings
PROC_OPT_KAFKA_OPTIMIZATION_TOPIC=optimization-recommendations
PROC_OPT_KAFKA_AUTO_OFFSET_RESET=latest
PROC_OPT_KAFKA_MAX_POLL_RECORDS=500

# --- PostgreSQL ---
PROC_OPT_DATABASE_URL=postgresql+asyncpg://optimizer:optimizer_dev_2024@postgres:5432/process_optimizer

# --- Optimizer ---
PROC_OPT_OPTIMIZATION_INTERVAL_SECONDS=10.0
PROC_OPT_NELDER_MEAD_MAX_ITERATIONS=200
PROC_OPT_NELDER_MEAD_XATOL=1e-6
PROC_OPT_NELDER_MEAD_FATOL=1e-6
PROC_OPT_PENALTY_WEIGHT_INITIAL=100.0
PROC_OPT_PENALTY_WEIGHT_GROWTH=10.0
PROC_OPT_COORDINATE_DESCENT_MAX_ITERATIONS=100

# --- PID Controller ---
PROC_OPT_PID_DEFAULT_KP=1.0
PROC_OPT_PID_DEFAULT_KI=0.1
PROC_OPT_PID_DEFAULT_KD=0.01
PROC_OPT_PID_DERIVATIVE_FILTER_ALPHA=0.1
PROC_OPT_PID_ANTI_WINDUP_CLAMP_MIN=-100.0
PROC_OPT_PID_ANTI_WINDUP_CLAMP_MAX=100.0
PROC_OPT_PID_ULTIMATE_GAIN_SAMPLES=500

# --- Process Model (FOPDT) ---
PROC_OPT_FOPDT_MIN_GAIN=0.01
PROC_OPT_FOPDT_MAX_GAIN=100.0
PROC_OPT_FOPDT_MIN_TIME_CONSTANT=0.1
PROC_OPT_FOPDT_MAX_TIME_CONSTANT=3600.0
PROC_OPT_FOPDT_MIN_DEAD_TIME=0.0
PROC_OPT_FOPDT_MAX_DEAD_TIME=600.0

# --- SPC (Statistical Process Control) ---
PROC_OPT_SPC_XBAR_WINDOW_SIZE=25
PROC_OPT_SPC_R_CHART_WINDOW_SIZE=25
PROC_OPT_SPC_CUSUM_THRESHOLD=5.0
PROC_OPT_SPC_CUSUM_DRIFT=0.5
PROC_OPT_SPC_WESTERN_ELECTRIC_ZONES=true

# --- OEE ---
PROC_OPT_OEE_PLANNED_PRODUCTION_HOURS=24.0
PROC_OPT_OEE_IDEAL_CYCLE_TIME_SECONDS=1.0

# --- WebSocket ---
PROC_OPT_WS_HEARTBEAT_INTERVAL_SECONDS=15.0
